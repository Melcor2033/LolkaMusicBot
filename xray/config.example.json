{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "port": 10808,
      "listen": "0.0.0.0",
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true
      }
    },
    {
      "port": 10809,
      "listen": "0.0.0.0",
      "protocol": "http",
      "settings": {}
    }
  ],
  "outbounds": [
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "YOUR_PROXY_SERVER_ADDRESS",
            "port": 443,
            "users": [
              {
                "id": "YOUR_VLESS_UUID",
                "encryption": "none",
                "level": 0
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": {
          "serverName": "YOUR_PROXY_SERVER_ADDRESS",
          "fingerprint": "chrome"
        },
        "wsSettings": {
          "path": "/api/v1/sync",
          "headers": {
            "Host": "YOUR_PROXY_SERVER_ADDRESS"
          }
        }
      }
    }
  ]
}
