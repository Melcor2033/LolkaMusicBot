# Настройки Discord бота
DISCORD_TOKEN=your_discord_bot_token_here

# Настройки базы данных PostgreSQL (оставьте по умолчанию при запуске через Docker)
DATABASE_URL=postgresql://bot_user:bot_password@db:5432/voicebot_db

# Логирование
LOG_LEVEL=INFO

# ==========================================
# Настройки Музыкальных Плееров (Feature Flags)
# ==========================================
# Включить/выключить Яндекс.Музыку
ENABLE_YANDEX_MUSIC=false
# Ключ шифрования для сохранения токенов Яндекс.Музыки в БД
# Обязателен, если ENABLE_YANDEX_MUSIC=true. 
# Сгенерировать ключ: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
YM_ENCRYPTION_KEY=

# Client ID приложения Яндекс.Музыки (публичное значение по умолчанию встроено в config.py).
# Переопределите, если хотите использовать собственное приложение.
# YM_CLIENT_ID=23cabbbdc6cd418abb4b39c32c41195d


# Включить смешивание в Моей Волне
ENABLE_BLEND=true

# Включить/выключить RuTube Music
ENABLE_RUTUBE_MUSIC=true

# Включить/выключить Lofi Radio 
ENABLE_LOFI_RADIO=false

# Включить/выключить Spotify / YouTube Музыку
ENABLE_SPOTIFY=false
# Данные для доступа к API Spotify (опционально, если нужно)
# SPOTIFY_CLIENT_ID=your_spotify_client_id
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# ==========================================
# Настройки Прокси и Обхода Блокировок
# ==========================================
# Раскомментируйте COMPOSE_PROFILES для запуска контейнера xray (прокси для обхода блокировок Spotify/YouTube)
# COMPOSE_PROFILES=spotify

# Укажите прокси, если используете Xray или сторонний прокси для скачивания (yt-dlp) и стриминга
# YTDLP_PROXY=http://xray:10809
# SPOTIFY_PROXY=http://xray:10809
# STREAM_PROXY=http://xray:10809

# Провайдеры поиска треков для Spotify (по умолчанию youtube,soundcloud)
# SPOTIFY_SEARCH_PROVIDERS=youtube,soundcloud

# ==========================================
# Дополнительные настройки бота
# ==========================================
# Имя бота по умолчанию при входе на сервер
DEFAULT_BOT_NICKNAME=Dynamic Voice

# Webhook URL для отправки логов/ошибок прямо в канал Discord (опционально)
# DISCORD_LOG_WEBHOOK_URL=https://discord.com/api/webhooks/123/abc

# Донаты и поддержка проекта (кнопки в панели)
# DONATION_BOOSTY_URL=
# DONATION_ALERTS_URL=

# Настройки VK Музыки (Если используется/будет добавлено)
# VK_COOKIE=
# VK_USER_TOKEN=
